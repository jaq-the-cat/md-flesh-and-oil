# Firebase web config. Public by design, but kept out of the repo so each
# deployment points at its own project. Security comes from firestore.rules.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Namespaces sheets under deploys/<id>/sheets. Required.
PUBLIC_DEPLOY_ID=
